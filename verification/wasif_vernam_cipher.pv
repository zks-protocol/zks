(* ============================================================================ *)
(* Wasif Vernam Cipher Formal Verification                                        *)
(* ============================================================================ *)
(* Models the 4-layer encryption primitive:                                     *)
(*   1. Seed Generation from Hierarchical Entropy Grid                         *)
(*   2. XChaCha20-Poly1305 Encryption                                           *)
(*   3. Role-based Nonces (initiator/responder)                                 *)
(*   4. Base64 Encoding                                                         *)
(*                                                                              *)
(* Security Properties Verified:                                                *)
(*   - Sensitive message secrecy (critical property)                           *)
(*   - Role-based keystream separation                                           *)
(* ============================================================================ *)

(* --- Type Declarations --- *)
type seed.          (* Entropy seed from Hierarchical Entropy Grid *)
type keystream_seed. (* Derived keystream seed *)
type role.          (* Role: initiator or responder *)
type key.           (* XChaCha20-Poly1305 key *)
type nonce.         (* XChaCha20 nonce *)
type plaintext.     (* Original message *)
type ciphertext.    (* Encrypted message *)
type base64.        (* Base64 encoded output *)

(* --- Channels --- *)
free c: channel.    (* Public network channel *)

(* --- Free Constants --- *)
free init_role: role.      (* Initiator role constant *)
free resp_role: role.       (* Responder role constant *)

(* --- Private Entropy Seeds --- *)
(* In the real Hierarchical Entropy Grid, entropy seeds are private *)
(* and not derivable from public round IDs *)
free entropy_round1: seed [private].

(* --- Hash Functions --- *)
fun sha256(bitstring): bitstring.

(* Derive swarm seed from entropy seed *)
fun derive_swarm_seed(seed): keystream_seed.

(* Derive keystream seed from swarm seed + role (role separation) *)
fun derive_keystream_seed(keystream_seed, role): keystream_seed.

(* Derive encryption key from keystream seed + role *)
fun hkdf(keystream_seed, role): key.

(* Derive nonce from keystream seed *)
fun derive_nonce(keystream_seed): nonce.

(* --- XChaCha20-Poly1305 AEAD Functions --- *)
fun xchacha20_encrypt(key, nonce, plaintext, bitstring): ciphertext.
fun xchacha20_decrypt(key, nonce, ciphertext, bitstring): plaintext.

(* --- Base64 Encoding/Decoding --- *)
fun base64_encode(ciphertext): base64.
fun base64_decode(base64): ciphertext.

(* --- Private Data --- *)
free sensitive_message: plaintext [private].

(* Free bitstrings for testing *)
free round1_id: bitstring.
free room_id: bitstring.

(* ============================================================================ *)
(* Security Queries                                                             *)
(* ============================================================================ *)

(* Query 1: Keystream seed secrecy *)
(* The entropy seed from the Hierarchical Entropy Grid remains private *)
query attacker(entropy_round1).

(* Query 2: Encryption key secrecy *)
(* The derived encryption key remains private *)
query attacker(hkdf(derive_keystream_seed(derive_swarm_seed(entropy_round1), init_role), init_role)).

(* Query 3: Sensitive message secrecy *)
(* The critical property: plaintext message cannot be recovered *)
query attacker(sensitive_message).

(* ============================================================================ *)
(* Main Process                                                                 *)
(* ============================================================================ *)

process
    (* Initiator process - encrypts sensitive message *)
    let seed_init = entropy_round1 in
    let swarm_seed_init = derive_swarm_seed(seed_init) in
    let ks_seed_init = derive_keystream_seed(swarm_seed_init, init_role) in
    let k_init = hkdf(ks_seed_init, init_role) in
    let n_init = derive_nonce(ks_seed_init) in
    let ct = xchacha20_encrypt(k_init, n_init, sensitive_message, room_id) in
    let encoded = base64_encode(ct) in
    out(c, encoded);
    
    (* Responder process - decrypts message *)
    let seed_resp = entropy_round1 in
    let swarm_seed_resp = derive_swarm_seed(seed_resp) in
    let ks_seed_resp = derive_keystream_seed(swarm_seed_resp, resp_role) in
    let k_resp = hkdf(ks_seed_resp, resp_role) in
    let n_resp = derive_nonce(ks_seed_resp) in
    let ct_resp = base64_decode(encoded) in
    let p = xchacha20_decrypt(k_resp, n_resp, ct_resp, room_id) in
    out(c, p)
